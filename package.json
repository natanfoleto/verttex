{
  "name": "verttex",
  "private": true,
  "prettier": "@verttex/prettier",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "quality": "pnpm verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @verttex/api db:generate",
    "db:migrate": "pnpm --filter @verttex/api db:migrate",
    "db:seed": "pnpm --filter @verttex/api db:seed",
    "db:clean": "pnpm --filter @verttex/api db:clean",
    "db:studio": "pnpm --filter @verttex/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "eslint": "^8.57.0",
    "typescript": "5.8.2"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.8.2",
      "@typescript-eslint/parser": "^8.24.0",
      "@typescript-eslint/eslint-plugin": "^8.24.0",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-react": "^7.37.0",
      "eslint-plugin-import": "^2.31.0",
      "eslint-plugin-jsx-a11y": "^6.10.0"
    }
  }
}
