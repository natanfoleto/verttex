{
  "name": "@verttex/marketplace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint && node -e \"const fs=require('fs');const p='./tsconfig.json';const c=JSON.parse(fs.readFileSync(p,'utf8'));c.compilerOptions.jsx='react-jsx';fs.writeFileSync(p,JSON.stringify(c,null,2));\"",
    "lint:fix": "next lint --fix && node -e \"const fs=require('fs');const p='./tsconfig.json';const c=JSON.parse(fs.readFileSync(p,'utf8'));c.compilerOptions.jsx='react-jsx';fs.writeFileSync(p,JSON.stringify(c,null,2));\"",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs');const p='./tsconfig.json';const c=JSON.parse(fs.readFileSync(p,'utf8'));if(c.compilerOptions.jsx!=='react-jsx'){c.compilerOptions.jsx='react-jsx';fs.writeFileSync(p,JSON.stringify(c,null,2));}\" && vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.64.1",
    "@verttex/auth": "workspace:*",
    "@verttex/env": "workspace:*",
    "@verttex/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^15.1.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@verttex/eslint-config": "workspace:*",
    "@verttex/tsconfig": "workspace:*",
    "eslint-config-next": "^15.1.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.21",
    "typescript": "5.8.2",
    "vitest": "^4.1.10"
  },
  "eslintConfig": {
    "extends": [
      "@verttex/eslint-config/react.js"
    ]
  }
}
