generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                   @id @default(cuid())
  name                 String
  email                String                   @unique
  phone                String?
  passwordHash         String
  status               String                   @default("active") // active, inactive, suspended
  roleId               String
  role                 Role                     @relation(fields: [roleId], references: [id])
  permissions          UserPermission[]
  stores               StoreUser[]
  sessions             UserSession[]
  passwordResetTokens  UserPasswordResetToken[]
  auditLogs            AuditLog[]
  files                File[]
  stockMovements       StockMovement[]
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean                  @default(false)
  twoFactorBackupCodes String[]
  deletedAt            DateTime?
  deletedBy            String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // admin, employee, supplier
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique // e.g. "users.read", "stores.create"
  module        String // e.g. "users", "roles", "stores"
  description   String?
  roles         RolePermission[]
  userOverrides UserPermission[]
  createdAt     DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String     // allow, deny
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model Store {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String?
  logoUrl            String?
  logoFileId         String?             @unique
  logoFile           File?               @relation("StoreLogoFile", fields: [logoFileId], references: [id], onDelete: SetNull)
  coverUrl           String?
  customDomain       String?
  status             String              @default("draft") // draft, active, inactive, suspended
  users              StoreUser[]
  products           Product[]
  variations         ProductVariation[]
  files              File[]
  lots               ProductLot[]
  inventoryLocations InventoryLocation[]
  stockItems         StockItem[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  cartItems          CartItem[]
  coupons            Coupon[]
  orders             Order[]
  stockReservations  StockReservation[]
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("stores")
}

model StoreUser {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOwner   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@map("store_users")
}

model Customer {
  id                  String                       @id @default(cuid())
  name                String
  email               String                       @unique
  phone               String?
  cpfCnpj             String?
  birthDate           DateTime?
  passwordHash        String
  status              String                       @default("active") // active, inactive, suspended
  sessions            CustomerSession[]
  passwordResetTokens CustomerPasswordResetToken[]
  addresses           CustomerAddress[]
  carts               Cart[]
  orders              Order[]
  personalizationProfile PersonalizationProfile?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String?  // Ex: "Casa", "Trabalho", "Sítio"
  recipient    String   // Nome do destinatário da entrega
  phone        String?  // Telefone de contato para entrega
  zipCode      String   // CEP (8 dígitos)
  street       String   // Rua / Logradouro
  number       String   // Número
  complement   String?  // Complemento (Apto, Bloco, etc.)
  neighborhood String   // Bairro
  city         String   // Cidade
  state        String   // Estado / UF (2 letras)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([customerId])
  @@map("customer_addresses")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  provider         String?   @default("credentials")
  lastActiveAt     DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("user_sessions")
}

model CustomerSession {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  provider         String?   @default("credentials")
  lastActiveAt     DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("customer_sessions")
}

model UserPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("user_password_reset_tokens")
}

model CustomerPasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("customer_password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RevokedToken {
  jti       String   @id // JWT ID (jti claim) — unique per access token
  expiresAt DateTime // Original token expiration — used for periodic cleanup
  revokedAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  imageUrl        String?
  iconUrl         String?
  parentId        String?
  position        Int       @default(0)
  status          String    @default("active") // active, inactive
  isVisible       Boolean   @default(true)
  metaTitle       String?
  metaDescription String?
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([status])
  @@index([position])
  @@map("categories")
}

model Brand {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  logoUrl         String?
  status          String    @default("active") // active, inactive
  isVisible       Boolean   @default(true)
  metaTitle       String?
  metaDescription String?
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@index([slug])
  @@index([status])
  @@map("brands")
}

model Product {
  id                        String             @id @default(cuid())
  storeId                   String
  store                     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId                String
  category                  Category           @relation(fields: [categoryId], references: [id])
  brandId                   String?
  brand                     Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name                      String
  slug                      String
  shortDescription          String?
  fullDescription           String?            @db.Text
  type                      String             @default("simple") // simple, variable
  status                    String             @default("draft") // draft, active, inactive, archived
  isPublished               Boolean            @default(false)
  isFeatured                Boolean            @default(false)
  weight                    Float? // em gramas
  width                     Float? // em cm
  height                    Float? // em cm
  length                    Float? // em cm
  metaTitle                 String?
  metaDescription           String?
  stockMode                 String             @default("SIMPLE") // NOT_TRACKED, SIMPLE, BATCH, BATCH_WITH_EXPIRATION
  hasBatchControl           Boolean            @default(false)
  hasExpirationControl      Boolean            @default(false)
  isExpirationRequired      Boolean            @default(false)
  defaultShelfLifeDays      Int?
  minReceivingShelfLifeDays Int?
  minDeliveryShelfLifeDays  Int?
  warningShelfLifeDays      Int?
  ncm                       String?
  cest                      String?
  fiscalOrigin              Int?
  commercialUnit            String?
  taxableUnit               String?
  createdBy                 String?
  updatedBy                 String?
  deletedAt                 DateTime?
  deletedBy                 String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  options    ProductOption[]
  variations ProductVariation[]
  medias     ProductMedia[]
  lots       ProductLot[]
  orderItems OrderItem[]

  searchDocument ProductSearchDocument?

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isPublished])
  @@index([status, isPublished, deletedAt])
  @@map("products")
}

model ProductSearchDocument {
  id                    String   @id @default(uuid())
  productId             String   @unique
  titleNormalized       String
  contextNormalized     String
  attributesNormalized  String
  descriptionNormalized String
  searchTextNormalized  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([searchTextNormalized])
  @@map("product_search_documents")
}


model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // ex: "Sabor", "Tamanho", "Peso"
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  values    ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id              String                  @id @default(cuid())
  optionId        String
  option          ProductOption           @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value           String // ex: "500g", "Curado", "Meia Cura"
  position        Int                     @default(0)
  variationValues ProductVariationValue[]

  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariation {
  id                        String                  @id @default(cuid())
  publicId                  String                  @unique @default(uuid())
  storeId                   String
  store                     Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId                 String
  product                   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                       String
  barcode                   String?
  price                     Decimal                 @db.Decimal(10, 2)
  promotionalPrice          Decimal?                @db.Decimal(10, 2)
  costPrice                 Decimal?                @db.Decimal(10, 2)
  isDefault                 Boolean                 @default(false)
  status                    String                  @default("active") // active, inactive
  weight                    Float?
  width                     Float?
  height                    Float?
  length                    Float?
  position                  Int                     @default(0)
  stockMode                 String?                 // NOT_TRACKED, SIMPLE, BATCH, BATCH_WITH_EXPIRATION
  hasBatchControl           Boolean?
  hasExpirationControl      Boolean?
  isExpirationRequired      Boolean?
  defaultShelfLifeDays      Int?
  minReceivingShelfLifeDays Int?
  minDeliveryShelfLifeDays  Int?
  warningShelfLifeDays      Int?
  ncm                       String?
  cest                      String?
  fiscalOrigin              Int?
  commercialUnit            String?
  taxableUnit               String?
  deletedAt                 DateTime?
  deletedBy                 String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  values            ProductVariationValue[]
  medias            ProductMedia[]
  lots              ProductLot[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]
  stockTransfers    StockTransfer[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
  @@index([publicId])
  @@index([sku])
  @@index([barcode])
  @@index([sku, barcode])
  @@index([status])
  @@map("product_variations")
}

model ProductVariationValue {
  id            String             @id @default(cuid())
  variationId   String
  variation     ProductVariation   @relation(fields: [variationId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variationId, optionValueId])
  @@map("product_variation_values")
}

model File {
  id           String         @id @default(cuid())
  publicId     String         @unique @default(cuid())
  provider     String         @default("cloudflare_r2") // cloudflare_r2, local
  bucket       String         @default("verttex-media")
  objectKey    String         @unique
  originalName String
  extension    String
  mimeType     String
  size         Int
  checksum     String?
  width        Int?
  height       Int?
  status       String         @default("pending") // pending, processing, approved, rejected
  purpose      String         @default("product_image") // product_image, category_icon, brand_logo, store_logo, store_banner, marketplace_logo, marketplace_favicon, marketplace_og_image, marketplace_banner, user_avatar
  storeId      String?
  store        Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  productMedia ProductMedia[]
  storeLogo    Store?         @relation("StoreLogoFile")

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("files")
}

model ProductMedia {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  fileId      String
  file        File              @relation(fields: [fileId], references: [id], onDelete: Cascade)
  altText     String?
  position    Int               @default(0)
  isMain      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@index([fileId])
  @@map("product_medias")
}

model ProductLot {
  id                String            @id @default(cuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationId       String?
  variation         ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  lotNumber         String            // Código do lote impresso no produto
  manufacturer      String?           // Fabricante
  supplier          String?           // Fornecedor
  manufacturingDate DateTime?         // Data de fabricação
  expirationDate    DateTime?         // Data de validade
  receivedAt        DateTime          @default(now())
  status            String            @default("available") // available, quarantine, blocked, recalled
  notes             String?           @db.Text
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  stockItems        StockItem[]
  stockMovements    StockMovement[]
  transfers         StockTransfer[]
  orderItemLots     OrderItemLot[]
  stockReservations StockReservation[]

  @@unique([storeId, productId, variationId, lotNumber])
  @@index([storeId])
  @@index([expirationDate])
  @@index([status])
  @@map("product_lots")
}

model InventoryLocation {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String   // ex: "Depósito Principal", "Câmara Fria 01"
  code      String   // ex: "DEP-01"
  isDefault Boolean  @default(false)
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems        StockItem[]
  sourceMovements   StockMovement[] @relation("SourceLocation")
  targetMovements   StockMovement[] @relation("TargetLocation")
  sourceTransfers   StockTransfer[] @relation("TransferSource")
  targetTransfers   StockTransfer[] @relation("TransferTarget")
  stockReservations StockReservation[]

  @@unique([storeId, code])
  @@map("inventory_locations")
}

model StockTransfer {
  id               String            @id @default(cuid())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variationId      String
  variation        ProductVariation  @relation(fields: [variationId], references: [id])
  lotId            String?
  lot              ProductLot?       @relation(fields: [lotId], references: [id])
  sourceLocationId String
  sourceLocation   InventoryLocation @relation("TransferSource", fields: [sourceLocationId], references: [id])
  targetLocationId String
  targetLocation   InventoryLocation @relation("TransferTarget", fields: [targetLocationId], references: [id])
  quantity         Int
  status           String            @default("CREATED") // CREATED, SEPARATED, IN_TRANSIT, RECEIVED, CANCELLED, REJECTED
  reason           String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([storeId])
  @@index([variationId])
  @@index([status])
  @@map("stock_transfers")
}

model StockItem {
  id               String            @id @default(cuid())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variationId      String
  variation        ProductVariation  @relation(fields: [variationId], references: [id], onDelete: Cascade)
  lotId            String?
  lot              ProductLot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  physicalQuantity Int               @default(0)
  reservedQuantity Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, variationId, lotId, locationId])
  @@map("stock_items")
}

model StockMovement {
  id               String             @id @default(cuid())
  storeId          String
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variationId      String
  variation        ProductVariation   @relation(fields: [variationId], references: [id])
  lotId            String?
  lot              ProductLot?        @relation(fields: [lotId], references: [id])
  sourceLocationId String?
  sourceLocation   InventoryLocation? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  targetLocationId String?
  targetLocation   InventoryLocation? @relation("TargetLocation", fields: [targetLocationId], references: [id])
  type             String             // RECEIVING, TRANSFER, RESERVATION, RELEASE_RESERVATION, DISPATCH, CUSTOMER_RETURN, SUPPLIER_RETURN, EXPIRATION_DISCARD, DAMAGE_DISCARD, QUARANTINE_ENTRY, QUARANTINE_RELEASE, BLOCK, RECALL, INVENTORY_ADJUSTMENT
  quantity         Int
  reason           String?
  referenceId      String?            // ID do pedido ou nota fiscal de referência
  userId           String?
  user             User?              @relation(fields: [userId], references: [id])
  createdAt        DateTime           @default(now())

  @@index([storeId])
  @@index([variationId])
  @@index([lotId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Cart {
  id         String       @id @default(cuid())
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  status     String       @default("active") // active, completed, abandoned
  items      CartItem[]
  coupons    CartCoupon[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id          String           @id @default(cuid())
  cartId      String
  cart        Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity    Int
  unitPrice   Decimal          @db.Decimal(10, 2)
  discount    Decimal          @default(0) @db.Decimal(10, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([cartId])
  @@index([variationId])
  @@index([storeId])
  @@map("cart_items")
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  type              String       // PERCENTAGE, FIXED
  value             Decimal      @db.Decimal(10, 2)
  minOrderValue     Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  storeId           String?
  store             Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  usageLimit        Int?
  usedCount         Int          @default(0)
  status            String       @default("active") // active, inactive
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  cartCoupons       CartCoupon[]

  @@map("coupons")
}

model CartCoupon {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  appliedAt DateTime @default(now())

  @@unique([cartId, couponId])
  @@map("cart_coupons")
}

model Order {
  id                String          @id @default(cuid())
  code              String          @unique // Código legível público ex: VTX-20260728-8912
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerAddressId String
  address           CustomerAddress @relation(fields: [customerAddressId], references: [id])
  status            String          @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  subtotal          Decimal         @db.Decimal(10, 2)
  shippingFee       Decimal         @default(0) @db.Decimal(10, 2)
  discount          Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal         @db.Decimal(10, 2)
  paymentMethod     String          @default("pix") // pix, credit_card, boleto
  paymentStatus     String          @default("pending") // pending, approved, failed, refunded
  notes             String?         @db.Text
  cancelReason      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items             OrderItem[]
  stockReservations StockReservation[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([code])
  @@map("orders")
}

model OrderItem {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  variationId    String
  variation      ProductVariation @relation(fields: [variationId], references: [id])
  productName    String           // Snapshot do nome do produto no ato da compra
  variationName  String           // Snapshot das opções escolhidas ex: "Curado / 500g"
  sku            String           // Snapshot do SKU
  price          Decimal          @db.Decimal(10, 2) // Snapshot do preço unitário cobrado
  costPrice      Decimal?         @db.Decimal(10, 2) // Snapshot do custo
  quantity       Int
  subtotal       Decimal          @db.Decimal(10, 2)
  imageUrl       String?          // Snapshot da foto do produto
  ncm            String?          // Snapshot fiscal
  cest           String?          // Snapshot fiscal
  fiscalOrigin   Int?             // Snapshot fiscal
  commercialUnit String?
  taxableUnit    String?

  itemLots OrderItemLot[]

  @@index([orderId])
  @@index([variationId])
  @@map("order_items")
}

model OrderItemLot {
  id          String     @id @default(cuid())
  orderItemId String
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  lotId       String
  lot         ProductLot @relation(fields: [lotId], references: [id])
  quantity    Int

  @@index([orderItemId])
  @@index([lotId])
  @@map("order_item_lots")
}

model StockReservation {
  id               String            @id @default(cuid())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variationId      String
  variation        ProductVariation  @relation(fields: [variationId], references: [id])
  lotId            String?
  lot              ProductLot?       @relation(fields: [lotId], references: [id])
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  reservedQuantity Int
  status           String            @default("ACTIVE") // ACTIVE, CONFIRMED, RELEASED, EXPIRED
  expiresAt        DateTime
  idempotencyKey   String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([storeId])
  @@index([orderId])
  @@index([variationId])
  @@index([status])
  @@map("stock_reservations")
}

model MarketplaceSettings {
  id                      String   @id @default(cuid())
  publicName              String   @default("VERTTEX Marketplace")
  logoFileId              String?
  faviconFileId           String?
  supportEmail            String?
  supportPhone            String?
  supportWhatsapp         String?
  address                 String?
  businessHours           String?
  metaTitle               String?
  metaDescription         String?
  ogImageFileId           String?
  announcementActive      Boolean  @default(false)
  announcementText        String?
  announcementLink        String?
  announcementDismissible  Boolean  @default(true)
  outOfStockBehavior      String   @default("show_badge")
  carouselAutoplay        Boolean  @default(true)
  carouselIntervalSeconds Int      @default(5)
  carouselTitlePosition   String?  @default("CENTER")
  carouselTitleHAlign     String?  @default("LEFT")
  updatedBy               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("marketplace_settings")
}

model CarouselBanner {
  id        String   @id @default(cuid())
  fileId    String?
  imageUrl  String?
  title     String
  subtitle  String?
  linkUrl   String?
  ctaText   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
  @@map("carousel_banners")
}

model PersonalizationProfile {
  id                     String    @id @default(uuid())
  customerId             String?   @unique
  customer               Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visitorKeyHash         String?   @unique
  personalizationEnabled Boolean   @default(true)
  lastSeenAt             DateTime  @default(now())
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([visitorKeyHash])
  @@index([customerId])
  @@map("personalization_profiles")
}

